# Local Postgres started by scripts/setup_db.sh (docker-compose.yml).
DATABASE_URL=postgresql://fireprotector:fireprotector@localhost:5432/fireprotector

# Or a hosted Postgres, e.g. Neon:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Where the asset rows live, and which columns hold the coordinates.
ASSET_SPECS_TABLE=protection.asset_specs
LATITUDE_COLUMN=latitude
LONGITUDE_COLUMN=longitude

# Row caps for /building_specs; /assets pages at ASSETS_PAGE_SIZE.
DEFAULT_LIMIT=500
MAX_LIMIT=10000

# Connection pool sizing.
POOL_MIN_SIZE=1
POOL_MAX_SIZE=10

# Browser origins allowed to call the API (JSON list).
CORS_ORIGINS=["*"]

# Deepfire fire-spread simulation API, used by GET /fire/arrival-grid and by
# the decision layer under /api. Get a client id/secret from deepfire.co.
# docker-compose.yml reads them from this file and passes them into the
# container. Without them, /fire/arrival-grid answers 500, and /api serves
# whatever scenario bundles are already recorded under data/bundles/ — so a
# recorded bundle keeps the whole UI working with no credentials at all.
DEEPFIRE_CLIENT_ID=
DEEPFIRE_CLIENT_SECRET=

# ---------------------------------------------------------- decision layer --
# Everything below is optional: /api runs on defaults without any of it.

# Nebius Token Factory, for the trilingual briefings. Leave empty to use the
# deterministic template briefings, which are valid by construction.
NEBIUS_API_KEY=
# NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Overpass mirrors for the named critical facilities (hospitals, schools,
# substations...), as a JSON array, tried in order. Leave empty for the
# provider's built-in list.
#
# Worth pinning when the default mirror is unreachable — but only to a mirror
# carrying PLANET-WIDE data. A regional mirror answers a Catalonia query with
# HTTP 200 and zero results, which is indistinguishable from "there is no
# hospital here", and the ranking quietly loses every named asset.
# OVERPASS_URLS=["https://overpass.kumi.systems/api"]

# Metres of slack around the outermost arrival contour when choosing which
# assets to score. Assets the fire never reaches score exactly zero, so a wide
# margin costs response size and buys nothing.
# REACHED_MARGIN_M=1000
