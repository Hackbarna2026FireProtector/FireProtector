# Fire-spread service (backend/fire_spread). Copy to .env; docker compose reads it.
ELMFIRE_NPROC=4                 # MPI ranks for ELMFIRE (ensemble members run in parallel)
DATA_DIR=/app/data/catalonia    # static 50 m COGs produced by scripts/prepare_static_data.py
RUNS_DIR=/app/data/runs         # per-request run directories
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_ENSEMBLE_BASE_URL=https://ensemble-api.open-meteo.com
KEEP_RUNS=failed                # all | failed | none
MAX_CONCURRENT_RUNS=1
DOMAIN_SIZE_M=40000             # simulation domain edge; ignition sits IGNITION_FRAC from the upwind edge
IGNITION_FRAC=0.3333            # 0.5 = centred
# LH_MOISTURE_PCT=60            # override the monthly live fuel moisture climatology
# LW_MOISTURE_PCT=90
# --- weather ---
# OPEN_METEO_ENSEMBLE_MODEL=icon_eu_eps   # or ecmwf_ifs025 (25 km, 50 members, has humidity)
# WEATHER_GRID_N=4                        # weather points per domain side (1 = uniform)
# WEATHER_ENSEMBLE=true                   # false: perturb the deterministic forecast instead
# WEATHER_HISTORY_HOURS=48                # spin-up for 10-h / 100-h fuel moisture
# FOLIAR_MOISTURE_PCT=90                  # override the monthly canopy moisture table
# --- physics ---
# CELL_SIZE_M=                            # default: resolution of the static tier (50; 30 with --res 30)
# USE_BARRIERS=true                       # needs data/catalonia/barrier.tif (OSM roads/rivers)
# DIURNAL_ADJUSTMENT=true                 # damp Rothermel at night
# OVERNIGHT_ADJUSTMENT_FACTOR=0.4
# MAX_LOW=8                               # fire ellipse length/width cap
# SPOTTING_DEFAULT=false                  # ember transport unless ?spotting= says otherwise
# FUEL_MODEL_SET=scott_burgan             # or mediterranean (provisional Catalan re-parameterisation)
# ADJ_FACTOR=1.0                          # global spread-rate multiplier (calibration; see docs/elmfire-pipe-assessment.md)
